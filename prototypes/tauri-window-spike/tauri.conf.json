{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Catstella Window Spike",
  "version": "0.1.0",
  "identifier": "com.catstella.research.window",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "pet",
        "title": "Catstella · Tauri 窗口实验",
        "width": 340,
        "height": 420,
        "center": true,
        "visible": false,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "resizable": false,
        "skipTaskbar": true,
        "alwaysOnTop": true
      },
      {
        "label": "settings",
        "title": "Catstella · 设置实验",
        "url": "settings.html",
        "width": 420,
        "height": 520,
        "visible": false,
        "decorations": false,
        "shadow": false,
        "resizable": false,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "../../Antigravity-Cat-Widget/assets/app-icon.ico"
    ]
  }
}